# texas 游戏服务器 — Starknet 主网生产配置（2026-09-07）
# 合约地址来源：poker_contracts/DEPLOYMENTS.md 主网章节 / strk20.json mainnet_prep
# operator = 主网 deployer 账户（.env.mainnet，合约 owner，余额 ~77 STRK）
PORT=9001
JWT_SECRET=dac008e94e282381352df70c68af88ed3e4eddaaa449963c3da6d2c995c4bca0
STARKNET_RPC_URL=https://starknet-rpc.publicnode.com
STARKNET_CHAIN_ID=SN_MAIN
STARKNET_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
STARKNET_VAULT_ADDRESS=0x3f4ef706ae2dc00ac685afffc05e5f1e1e9ab5aacf99c3205d2067e061cbb45
STARKNET_SETTLEMENT_ADDRESS=0x2bf6a09c0aaea154de34745056e7534f58fa0805c12afe18cf22a9bc66ee7a8
STARKNET_DUAL_SETTLEMENT_ADDRESS=0x1d39b80b990038ceeeaf3d39e83cb83031be95c0d0ccca5d18c5faea29aef6d
STARKNET_CLAIM_HELPER_ADDRESS=0x402372930ea52cccbafa459169b3dae3d67051ed741e9af7da669a0f1fbb308
# 隐私结算入口（赢家均注册 payout commitment 时生效）
STARKNET_SETTLE_PRIVATE=true
# 结算模式：snip36（递归证明，失败自动回退 legacy）
STARKNET_SETTLEMENT_MODE=snip36
# DAPV settle 上链入口：v2 = fact-registry 单证明锚（稳定入口，可随时回退）
STARKNET_DAPV_SETTLE_ENTRY=v2
# operator = 主网 deployer/owner（register/settle 提交方）
STARKNET_OPERATOR_ADDRESS=0x412e4d435b98fa7112bf6a61eed6cf38694278af3072cddd2efade2e46121a6
STARKNET_OPERATOR_PRIVATE_KEY=0x996ecd890105c7a99f4f471268ef91dd5967cee9fdabfa8268645db55d375d
# 主网生产：登录签名必须链上验证（false = dev 跳过后门）
STARKNET_AUTH_STRICT=true
BETTING_TIMEOUT_SECS=90
# 抽水：5%，单手上限 1000 chips，接收方 = operator 账户
STARKNET_TREASURY_ADDRESS=0x412e4d435b98fa7112bf6a61eed6cf38694278af3072cddd2efade2e46121a6
STARKNET_RAKE_BPS=500
STARKNET_RAKE_CAP=1000
RUST_LOG=info
