# batch-poster 运营配置（deploy 模板）——对照 deploy/texas-server.env 惯例，
# 但【绝不放明文私钥入库】：本文件进仓库的是模板，真实部署文件放
# /opt/texas/batch-poster.env 且 chmod 600（texas-server.env:21 明文私钥是
# 已知反面教材，轮换计划见 docs/MAINNET_TX_GUIDE.md 密钥分级一节）。

# ---- 发送面（与 texas 同源 env 名，缺一 fail-closed 拒绝启动）----
STARKNET_RPC_URL=https://starknet-rpc.publicnode.com
STARKNET_CHAIN_ID=SN_MAIN
STARKNET_OPERATOR_ADDRESS=<operator 地址——只发 register/settle 的热钱包>
# 私钥放真实部署文件，不进 git：
STARKNET_OPERATOR_PRIVATE_KEY=<operator 私钥——不得与 owner 相同，见 MAINNET_TX_GUIDE>

# ---- 单写者交接目录（生产用绝对路径；texas 侧同名值必须一致）----
# texas: TEXAS_SETTLE_QUEUE_WAL / TEXAS_SETTLE_SIDECAR_DIR
# poster: TEXAS_POSTER_QUEUE_WAL / TEXAS_POSTER_SIDECAR_DIR
# 缺省相对路径同值（settle-queue/queue.jsonl、poster-sidecar），同机同根
# 可省略；跨目录/多进程部署必须两边都配成同一绝对路径。
TEXAS_POSTER_QUEUE_WAL=/opt/texas/settle-queue/queue.jsonl
TEXAS_POSTER_SIDECAR_DIR=/opt/texas/poster-sidecar

# ---- fold 攒批（运营默认值说明见 batch-poster/src/config.rs）----
# 开关缺省 false；启用前先跑 scripts/batch-poster-smoke.sh 干跑核对。
#TEXAS_POSTER_FOLD_ENABLED=1
#TEXAS_POSTER_MAX_BATCH_HANDS=64
#TEXAS_POSTER_MAX_WAIT_SECS=300
#TEXAS_POSTER_MIN_BATCH_HANDS=1
#TEXAS_POSTER_PROVE_SCRIPT=../proving-tool/prove-batch.sh
#TEXAS_POSTER_PROVE_BASE_INPUT=<必填：基础手输入 JSON（102 词/手语料）>
#TEXAS_POSTER_PROVE_WORK_DIR=/tmp/zgame-batch-poster
#TEXAS_POSTER_MAX_PROVE_ATTEMPTS=3

# ---- 监控告警阈值（batch-poster/src/status.rs env 直读；未设置=不告警）----
# 数值为示例起步值，按上线后实测校准（docs/BATCH_POSTER_OPS.md 校准方法）。
TEXAS_POSTER_ALERT_MAX_PENDING_TASKS=200
TEXAS_POSTER_ALERT_MAX_PENDING_BATCHES=8
# 最老批年龄：fold 开启后批应在 ~出证时长(实测 ~52s)+提交轮询内消化，超 1h 视为停滞。
TEXAS_POSTER_ALERT_MAX_BATCH_AGE_SECS=3600
TEXAS_POSTER_ALERT_MAX_IN_FLIGHT_TXS=16
# operator 余额下限（STRK wei）——survey §9.7「Arbitrum 按 ~3 天成本告警」：
# 余额 < 约 3 天发帖 gas 开销即告。示例 ≈150 STRK 为占位，须按实测日均消耗×3 校准。
#TEXAS_POSTER_ALERT_MIN_BALANCE_WEI=150000000000000000000

RUST_LOG=info
