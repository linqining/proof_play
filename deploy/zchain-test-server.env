# ============================================================================
# ZChain 测试部署 — texas 测试实例环境（/opt/texas-test/.env）
#
# 与生产 deploy/texas-server.env（Starknet 主网结算）的关键差异：
#   PORT=1443            生产 9001（strk.secretpokers.com）
#   TEXAS_ENV=dev        无 Starknet RPC/合约地址：买入不入账、登录不链上验签
#   TEXAS_PROVER_MODE=dev  进程内本地证明器（生产走远程 proving 服务）
#   TEXAS_APPCHAIN=1     结算出口 = 嵌入式 appchain → sequencer.wal
#                        → explorer_gateway(:18900) → poker_air_bridge
#                        → zchain 4 节点(:18545-18548) 逐笔锚定
#   STARKNET_AUTH_STRICT=false  生产 true
#   STARKNET_RAKE_BPS=0  生产 500
#
# 运行目录：/opt/texas-test/run/{appchain,keys,logs,*.pid}
# 启停：bash /opt/texas-test/start-test.sh [桥目标手数]
# 冻结看门狗：systemd texas-test-guard（≥240s 无 hand complete 自动重启本栈）
# ============================================================================
PORT=1443
# JWT_SECRET 每次由 start-test.sh 重新生成（测试实例，无状态要求）
TEXAS_ENV=dev
TEXAS_PROVER_MODE=dev
# 服务端 bot 注入端点（POST /api/dev/bot），供空座自动补位
TEXAS_DEV_BOT_ENABLED=1
# 嵌入式 appchain 结算出口
TEXAS_APPCHAIN=1
TEXAS_APPCHAIN_WAL_DIR=/opt/texas-test/run/appchain
TEXAS_APPCHAIN_SEQUENCER_SEED=<run/sequencer.seed，32B hex>
TEXAS_APPCHAIN_ATTESTOR_SEED=<run/attestor.seed，32B hex>
TEXAS_APPCHAIN_ASSET=play
TEXAS_APPCHAIN_PROVIDER=mock
STARKNET_SETTLEMENT_EXIT=appchain
STARKNET_AUTH_STRICT=false
STARKNET_RAKE_BPS=0
RUST_LOG=info
BETTING_TIMEOUT_SECS=8
BOT_LOOP_SECS=0
